# Use a 100 Hz (10 ms) scheduler tick.
CONFIG_FREERTOS_HZ=100

# The ESP32-S3 Feather build uses 2 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y

# Do not link Espressif radio binary libraries. Wi-Fi and Bluetooth cannot be
# initialized in this build, even if accidentally referenced later.
CONFIG_APP_NO_BLOBS=y

# Route the primary diagnostic console through the built-in USB Serial/JTAG port.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
