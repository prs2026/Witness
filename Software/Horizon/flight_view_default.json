{
  "version": 1,
  "description": "Fixed, non-scrolling launch dashboard: overview/state left, six plots center, GPS and power right. W=Witness, A=AIM, F=Featherweight. Unmapped fields explicitly show N/A. AIM altitude/battery remain raw because publisher units are unverified. Horizontal distance is relative to the first valid live position or Set pad; barometric/GPS altitudes are not automatically zeroed. Configure field mappings, conversions and trace units here; see flight_view.py. Featherweight RX_NOMTK provides tracker battery and RSSI; BATT_BLE is the local serial-connected device battery, kept separate. Zero battery readings are unavailable, not valid voltage measurements. AIM acceleration is AZ on an independent right raw axis (units unverified). AIM gyro AX~/AY~/AZ~ are quaternion-derived angular-rate estimates in deg/s, not raw gyro. Window selector changes time span without clearing history.",
  "title": "Horizon Flight View",
  "window_seconds": 120,
  "refresh_ms": 250,
  "columns": 2,
  "max_points": 6000,
  "gap_seconds": 3,
  "plots": [
    {
      "title": "Altitude",
      "unit": "m",
      "traces": [
        {
          "label": "W baro",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "barometric_altitude",
          "color": "#171717"
        },
        {
          "label": "F GPS",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "altitude_ft",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          },
          "scale": 0.3048
        }
      ]
    },
    {
      "title": "Acceleration",
      "unit": "g",
      "traces": [
        {
          "label": "WX",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "filtered_accel[0]",
          "color": "#004b80"
        },
        {
          "label": "WY",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "filtered_accel[1]",
          "color": "#803900"
        },
        {
          "label": "WZ",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "filtered_accel[2]",
          "color": "#006020"
        },
        {
          "label": "AZ",
          "input": "aim",
          "packet": "z_acceleration_payload/v1",
          "field": "z_acceleration",
          "color": "#990000",
          "axis": "right",
          "note": "AIM units unverified; separate raw axis"
        }
      ],
      "right_unit": "A raw"
    },
    {
      "title": "Gyro (A est.)",
      "unit": "deg/s",
      "traces": [
        {
          "label": "WX",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "gyro[0]",
          "color": "#004b80"
        },
        {
          "label": "WY",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "gyro[1]",
          "color": "#803900"
        },
        {
          "label": "WZ",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "gyro[2]",
          "color": "#006020"
        },
        {
          "label": "AX~",
          "input": "aim",
          "packet": "orientation_payload/v1",
          "field": "_derived.gyro_dps[0]",
          "color": "#004b80",
          "note": "Quaternion-derived deg/s estimate; AIM frame/mounting unverified"
        },
        {
          "label": "AY~",
          "input": "aim",
          "packet": "orientation_payload/v1",
          "field": "_derived.gyro_dps[1]",
          "color": "#803900",
          "note": "Quaternion-derived deg/s estimate; AIM frame/mounting unverified"
        },
        {
          "label": "AZ~",
          "input": "aim",
          "packet": "orientation_payload/v1",
          "field": "_derived.gyro_dps[2]",
          "color": "#006020",
          "note": "Quaternion-derived deg/s estimate; AIM frame/mounting unverified"
        }
      ]
    },
    {
      "title": "Vertical velocity",
      "unit": "m/s",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "velocity[2]",
          "color": "#171717"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "vertical_velocity_fps",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          },
          "scale": 0.3048
        }
      ]
    },
    {
      "title": "Horizontal distance",
      "unit": "m",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "_derived.horizontal_distance_m",
          "color": "#171717"
        },
        {
          "label": "A",
          "input": "aim",
          "packet": "gnss_payload/v1",
          "field": "_derived.horizontal_distance_m",
          "color": "#990000"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "_derived.horizontal_distance_m",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          }
        }
      ]
    },
    {
      "title": "RSSI",
      "unit": "reported",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": "ground_station_status",
          "field": "rssi",
          "color": "#171717"
        },
        {
          "label": "A",
          "input": "aim",
          "packet": [
            "rssi_payload/v1",
            "received_packet_signal_quality_payload/v1"
          ],
          "field": "rssi",
          "color": "#990000"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "RX_NOMTK",
          "field": "rssi_dbm",
          "color": "#006020"
        }
      ]
    }
  ],
  "readouts": [
    {
      "group": "flight",
      "title": "Altitude",
      "unit": "m",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "barometric_altitude",
          "color": "#171717"
        },
        {
          "label": "A",
          "input": "aim",
          "packet": "gnss_payload/v1",
          "field": "gnss_coordinate.altitude",
          "color": "#990000",
          "unit": "raw"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "altitude_ft",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          },
          "scale": 0.3048
        }
      ]
    },
    {
      "group": "flight",
      "title": "Vertical velocity",
      "unit": "m/s",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "velocity[2]",
          "color": "#171717"
        },
        {
          "label": "A",
          "input": "aim",
          "packet": "(unmapped)",
          "field": "(unmapped)",
          "color": "#990000",
          "enabled": false,
          "note": "Not exposed by current AIM schema"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "vertical_velocity_fps",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          },
          "scale": 0.3048
        }
      ]
    },
    {
      "group": "flight",
      "title": "Horizontal distance",
      "unit": "m",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "_derived.horizontal_distance_m",
          "color": "#171717"
        },
        {
          "label": "A",
          "input": "aim",
          "packet": "gnss_payload/v1",
          "field": "_derived.horizontal_distance_m",
          "color": "#990000"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "_derived.horizontal_distance_m",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          }
        }
      ]
    },
    {
      "group": "state",
      "title": "Witness flight state",
      "unit": "state",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug",
            "sensors",
            "heartbeat"
          ],
          "field": "status.flight_state",
          "color": "#171717",
          "format": "state"
        }
      ]
    },
    {
      "group": "gps",
      "title": "Witness GPS satellites",
      "unit": "sats",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "(unmapped)",
          "color": "#171717",
          "enabled": false,
          "note": "Not in Witness telemetry"
        }
      ]
    },
    {
      "group": "gps",
      "title": "AIM GPS satellites",
      "unit": "sats",
      "traces": [
        {
          "label": "A",
          "input": "aim",
          "packet": "gnss_payload/v1",
          "field": "satellites_used",
          "color": "#990000"
        }
      ]
    },
    {
      "group": "gps",
      "title": "Featherweight satellites",
      "unit": "sats",
      "traces": [
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "satellites_total",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          }
        }
      ]
    },
    {
      "group": "gps",
      "title": "Featherweight fix",
      "unit": "mode",
      "traces": [
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "fix_type",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          },
          "note": "0=no fix, 2=2D, 3=3D"
        }
      ]
    },
    {
      "group": "power",
      "title": "Witness battery",
      "unit": "V",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "witness_battery_voltage",
          "color": "#171717"
        }
      ]
    },
    {
      "group": "power",
      "title": "IRIS battery",
      "unit": "V",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "camera",
            "iris_debug"
          ],
          "field": "iris_battery_voltage",
          "color": "#171717"
        }
      ]
    },
    {
      "group": "power",
      "title": "AIM computer battery",
      "unit": "raw",
      "traces": [
        {
          "label": "A",
          "input": "aim",
          "packet": "computer_battery_payload/v1",
          "field": "voltage",
          "color": "#990000"
        }
      ]
    },
    {
      "group": "power",
      "title": "AIM ejection battery",
      "unit": "raw",
      "traces": [
        {
          "label": "A",
          "input": "aim",
          "packet": "ejection_battery_payload/v1",
          "field": "voltage",
          "color": "#990000"
        }
      ]
    },
    {
      "group": "power",
      "title": "AIM continuity 1",
      "unit": "state",
      "traces": [
        {
          "label": "A",
          "input": "aim",
          "packet": "(unmapped)",
          "field": "(unmapped)",
          "color": "#990000",
          "format": "continuity",
          "enabled": false,
          "note": "Topic / field not mapped"
        }
      ]
    },
    {
      "group": "power",
      "title": "AIM continuity 2",
      "unit": "state",
      "traces": [
        {
          "label": "A",
          "input": "aim",
          "packet": "(unmapped)",
          "field": "(unmapped)",
          "color": "#990000",
          "format": "continuity",
          "enabled": false,
          "note": "Topic / field not mapped"
        }
      ]
    },
    {
      "group": "power",
      "title": "FW tracker battery",
      "unit": "V",
      "traces": [
        {
          "label": "F",
          "input": "featherweight",
          "packet": "RX_NOMTK",
          "field": "tracker_battery_voltage_v",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          }
        }
      ]
    },
    {
      "group": "power",
      "title": "FW local / GS battery",
      "unit": "V",
      "traces": [
        {
          "label": "F local",
          "input": "featherweight",
          "packet": "BATT_BLE",
          "field": "battery_voltage_v",
          "color": "#006020"
        }
      ]
    }
  ]
}
