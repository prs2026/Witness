{
  "version": 1,
  "description": "Fixed, non-scrolling launch dashboard. W=Witness, A=AIM, F=Featherweight. A baro~ is standard pressure altitude (shown in ft), interpreting AIM pressure as Pa with 101325 Pa reference; A~ vertical velocity is delta barometric altitude / delta publisher timestamp in ft/s, positive up. These are estimates, not AIM calibrated/fused outputs. A GPS remains raw on the right altitude axis and GPS readout (publisher units unverified). Altitudes are shown in feet (ft) above the pad, velocities in ft/s; the layout units m and m/s are SI internally and converted only for display, so keep them as m / m/s here. Altitudes are above the pad: W KF is Witness's Kalman altitude (already AGL); F GPS is Featherweight ft ASL minus the pad MSL altitude (Featherweight GS, Aperture GPS, Witness pad GPS, else its first fix); A baro~ is referenced to its first live sample. Set pad re-references F/A altitudes. The Gyro graph shows Witness body rates in deg/s (sensors packet) and the AIM AX~/AY~/AZ~ estimates; the Gyro readout shows Witness X/Y/Z. Invalid data holds the last valid readout with original age and an INVALID flag, with gaps in plots. FW tracker and local/GS batteries stay separate. Zero battery readings are invalid. AIM vectors are in Witness axes per the 'AIM axes...' setting (Map & Attitude): AIM acceleration (one raw component along AIM Z) is drawn as A X/Y/Z on the Witness axis it lies along, on a separate raw axis; AX~/AY~/AZ~ gyro traces are quaternion-derived deg/s estimates in Witness axes. Window selector preserves history. The Witness GPS row shows satellites used beside the status GPS lock bit (1 = fresh fix). The state row adds the Witness HITL bit: HITL ACTIVE means simulated sensors, never flight data. Graph arrangement: the first graph (Altitude AGL) is a full-width row, the other four form a 2x2 grid under it (portrait 9:16 first; Gyro replaced Horizontal distance on 2026-11-18, add distance back in the Layout Editor if wanted). See flight_view.py for configuration.",
  "title": "Horizon Flight View",
  "window_seconds": 120,
  "auto_scale": true,
  "refresh_ms": 250,
  "columns": 2,
  "max_points": 6000,
  "gap_seconds": 7,
  "plots": [
    {
      "title": "Altitude AGL",
      "unit": "m",
      "right_unit": "GPS raw",
      "traces": [
        {
          "label": "W KF",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "kalman_altitude",
          "color": "#171717",
          "note": "Witness Kalman altitude above the pad (shown in ft)"
        },
        {
          "label": "F GPS",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "_derived.altitude_agl_m",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          },
          "note": "Featherweight ft ASL minus pad MSL (rel. to first fix if none)"
        },
        {
          "label": "A baro~",
          "input": "aim",
          "packet": "pressure_payload/v1",
          "field": "_derived.barometric_altitude_agl_m",
          "color": "#990000",
          "note": "Pressure altitude (Pa, 101325 Pa ref) minus its first live sample"
        },
        {
          "label": "A GPS",
          "input": "aim",
          "packet": "gnss_payload/v1",
          "field": "gnss_coordinate.altitude",
          "color": "#5b267d",
          "axis": "right",
          "note": "GPS publisher units unverified; separate raw axis"
        },
        {
          "label": "W GPS",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "_derived.gps_altitude_agl_m",
          "color": "#7a3300",
          "note": "Witness GNSS MSL minus pad MSL (rel. to first fix if none); lock only"
        }
      ]
    },
    {
      "title": "Acceleration",
      "unit": "g",
      "traces": [
        {
          "label": "WX",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "filtered_accel[0]",
          "color": "#004b80"
        },
        {
          "label": "WY",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "filtered_accel[1]",
          "color": "#803900"
        },
        {
          "label": "WZ",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "filtered_accel[2]",
          "color": "#006020"
        },
        {
          "label": "AX",
          "input": "aim",
          "packet": "z_acceleration_payload/v1",
          "field": "_derived.accel_witness[0]",
          "color": "#004b80",
          "axis": "right",
          "note": "AIM raw units, Witness X per 'AIM axes...' (AIM measures its Z only)"
        },
        {
          "label": "AY",
          "input": "aim",
          "packet": "z_acceleration_payload/v1",
          "field": "_derived.accel_witness[1]",
          "color": "#803900",
          "axis": "right",
          "note": "AIM raw units, Witness Y per 'AIM axes...' (AIM measures its Z only)"
        },
        {
          "label": "AZ",
          "input": "aim",
          "packet": "z_acceleration_payload/v1",
          "field": "_derived.accel_witness[2]",
          "color": "#006020",
          "axis": "right",
          "note": "AIM raw units, Witness Z per 'AIM axes...' (AIM measures its Z only)"
        }
      ],
      "right_unit": "A raw"
    },
    {
      "title": "Vertical velocity",
      "unit": "m/s",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "velocity[2]",
          "color": "#171717"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "vertical_velocity_fps",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          },
          "scale": 0.3048
        },
        {
          "label": "A~",
          "input": "aim",
          "packet": "pressure_payload/v1",
          "field": "_derived.vertical_velocity_mps",
          "color": "#990000",
          "note": "Estimated from successive barometric altitudes; positive upwards"
        }
      ]
    },
    {
      "title": "Gyro",
      "unit": "deg/s",
      "traces": [
        {
          "label": "WX",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "gyro[0]",
          "color": "#004b80",
          "note": "Witness IMU gyro, body axis, deg/s"
        },
        {
          "label": "WY",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "gyro[1]",
          "color": "#803900",
          "note": "Witness IMU gyro, body axis, deg/s"
        },
        {
          "label": "WZ",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "gyro[2]",
          "color": "#006020",
          "note": "Witness IMU gyro, body axis, deg/s"
        },
        {
          "label": "AX~",
          "input": "aim",
          "packet": "orientation_payload/v1",
          "field": "_derived.gyro_dps[0]",
          "color": "#004b80",
          "note": "AIM rate estimated from successive orientation quaternions, deg/s"
        },
        {
          "label": "AY~",
          "input": "aim",
          "packet": "orientation_payload/v1",
          "field": "_derived.gyro_dps[1]",
          "color": "#803900",
          "note": "AIM rate estimated from successive orientation quaternions, deg/s"
        },
        {
          "label": "AZ~",
          "input": "aim",
          "packet": "orientation_payload/v1",
          "field": "_derived.gyro_dps[2]",
          "color": "#006020",
          "note": "AIM rate estimated from successive orientation quaternions, deg/s"
        }
      ]
    },
    {
      "title": "RSSI",
      "unit": "reported",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": "ground_station_status",
          "field": "rssi",
          "color": "#171717"
        },
        {
          "label": "A",
          "input": "aim",
          "packet": [
            "rssi_payload/v1",
            "received_packet_signal_quality_payload/v1"
          ],
          "field": "rssi",
          "color": "#990000"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "RX_NOMTK",
          "field": "rssi_dbm",
          "color": "#006020"
        }
      ]
    }
  ],
  "readouts": [
    {
      "group": "flight",
      "title": "Altitude AGL",
      "unit": "m",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "kalman_altitude",
          "color": "#171717",
          "note": "Witness Kalman altitude above the pad (shown in ft)"
        },
        {
          "label": "A baro~",
          "input": "aim",
          "packet": "pressure_payload/v1",
          "field": "_derived.barometric_altitude_agl_m",
          "color": "#990000",
          "note": "Pressure altitude (Pa, 101325 Pa ref) minus its first live sample"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "_derived.altitude_agl_m",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          },
          "note": "Featherweight ft ASL minus pad MSL (rel. to first fix if none)"
        }
      ]
    },
    {
      "group": "flight",
      "title": "Vertical velocity",
      "unit": "m/s",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "velocity[2]",
          "color": "#171717"
        },
        {
          "label": "A~",
          "input": "aim",
          "packet": "pressure_payload/v1",
          "field": "_derived.vertical_velocity_mps",
          "color": "#990000",
          "note": "Estimated from barometric altitude differences; positive upwards"
        },
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "vertical_velocity_fps",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          },
          "scale": 0.3048
        }
      ]
    },
    {
      "group": "flight",
      "title": "Gyro",
      "unit": "deg/s",
      "traces": [
        {
          "label": "WX",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "gyro[0]",
          "color": "#004b80",
          "note": "Witness IMU gyro, body axis, deg/s"
        },
        {
          "label": "WY",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "gyro[1]",
          "color": "#803900",
          "note": "Witness IMU gyro, body axis, deg/s"
        },
        {
          "label": "WZ",
          "input": "witness",
          "packet": [
            "sensors",
            "witness_debug"
          ],
          "field": "gyro[2]",
          "color": "#006020",
          "note": "Witness IMU gyro, body axis, deg/s"
        }
      ]
    },
    {
      "group": "state",
      "title": "Witness flight state",
      "unit": "state",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug",
            "sensors",
            "heartbeat"
          ],
          "field": "status.flight_state",
          "color": "#171717",
          "format": "state"
        },
        {
          "label": "HITL",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug",
            "sensors",
            "heartbeat"
          ],
          "field": "status.hitl_active",
          "color": "#990000",
          "format": "hitl",
          "note": "Status byte 1 bit 4: 1 = HITL, sensor values are simulated"
        }
      ]
    },
    {
      "group": "gps",
      "title": "Witness",
      "unit": "sats",
      "traces": [
        {
          "label": "GPS sats",
          "input": "witness",
          "packet": "state",
          "field": "gps_satellites",
          "color": "#171717",
          "note": "Satellites used (GGA field 7); 0 when the fix is stale"
        },
        {
          "label": "lock",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug",
            "sensors",
            "heartbeat"
          ],
          "field": "status.gps_locked",
          "color": "#171717",
          "format": "flag",
          "note": "Status byte 1 bit 3: 1 = fresh GPS fix"
        }
      ]
    },
    {
      "group": "gps",
      "title": "AIM GPS satellites",
      "unit": "sats",
      "traces": [
        {
          "label": "A",
          "input": "aim",
          "packet": "gnss_payload/v1",
          "field": "satellites_used",
          "color": "#990000"
        }
      ]
    },
    {
      "group": "gps",
      "title": "Featherweight satellites",
      "unit": "sats",
      "traces": [
        {
          "label": "F",
          "input": "featherweight",
          "packet": "GPS_STAT",
          "field": "satellites_total",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          }
        }
      ]
    },
    {
      "group": "power",
      "title": "Witness battery",
      "unit": "V",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "state",
            "witness_debug"
          ],
          "field": "witness_battery_voltage",
          "color": "#171717"
        }
      ]
    },
    {
      "group": "power",
      "title": "IRIS battery",
      "unit": "V",
      "traces": [
        {
          "label": "W",
          "input": "witness",
          "packet": [
            "camera",
            "iris_debug"
          ],
          "field": "iris_battery_voltage",
          "color": "#171717"
        }
      ]
    },
    {
      "group": "power",
      "title": "AIM CPU / eject battery",
      "unit": "raw",
      "traces": [
        {
          "label": "CPU",
          "input": "aim",
          "packet": "computer_battery_payload/v1",
          "field": "voltage",
          "color": "#990000"
        },
        {
          "label": "Eject",
          "input": "aim",
          "packet": "ejection_battery_payload/v1",
          "field": "voltage",
          "color": "#990000"
        }
      ]
    },
    {
      "group": "power",
      "title": "FW tracker battery",
      "unit": "V",
      "traces": [
        {
          "label": "F",
          "input": "featherweight",
          "packet": "RX_NOMTK",
          "field": "tracker_battery_voltage_v",
          "color": "#006020",
          "match": {
            "unit_type": "TRACKER"
          }
        }
      ]
    },
    {
      "group": "power",
      "title": "FW local / GS battery",
      "unit": "V",
      "traces": [
        {
          "label": "F local",
          "input": "featherweight",
          "packet": "BATT_BLE",
          "field": "battery_voltage_v",
          "color": "#006020"
        }
      ]
    }
  ]
}
