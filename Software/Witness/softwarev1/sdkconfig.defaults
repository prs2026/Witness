# FreeRTOS uses one 500 Hz (2 ms) scheduler tick rate across both ESP32-S3 cores.
# The sensor task runs its 100 Hz IMU/attitude loop as a 5-tick period.
CONFIG_FREERTOS_HZ=1000

# Route the primary diagnostic console through the built-in USB Serial/JTAG port.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set

# Run-time stats so Witness can report per-core and per-task CPU load
# (cpu_load.cpp), clocked by esp_timer with a 64-bit counter.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
