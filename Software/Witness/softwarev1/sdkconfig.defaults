# FreeRTOS uses one 500 Hz (2 ms) scheduler tick rate across both ESP32-S3 cores.
# The sensor task runs its 100 Hz IMU/attitude loop as a 5-tick period.
CONFIG_FREERTOS_HZ=1000

# Route the primary diagnostic console through the built-in USB Serial/JTAG port.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set

# Run-time stats so Witness can report per-core and per-task CPU load
# (cpu_load.cpp), clocked by esp_timer with a 64-bit counter.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# ESP32-S3FN8: 8 MB in-package flash, two OTA application slots (partitions.csv).
# nvs/phy_init stay at their old 2 MB-layout offsets so IMU calibration in NVS
# survives the one-time USB migration flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# A new OTA image boots as "pending verify" and rolls back unless wifi_ota.cpp
# marks it valid after its self-test (or it crashes/resets first).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Wi-Fi OTA / log download: Wi-Fi and lwIP run on core 0; core 1 is the sensor
# task's. Bluetooth stays off.
# CONFIG_BT_ENABLED is not set
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Keep the Wi-Fi heap footprint small (a two-station AP carrying one transfer).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# Keep Wi-Fi code in flash, not internal RAM: with the IRAM optimisations on,
# the Wi-Fi stack's code took enough DIRAM that Sensors::start() ran out of
# heap at boot (ESP_ERR_NO_MEM). Throughput only matters for pad-side uploads.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# Smallest Wi-Fi that does the job: one WPA2-PSK soft-AP, one HTTP transfer.
# No IPv6, no WPA3/OWE/enterprise, no A-MPDU aggregation, fewer sockets and
# management buffers; Wi-Fi never touches NVS (IMU calibration lives there).
# CONFIG_LWIP_IPV6 is not set
CONFIG_LWIP_MAX_SOCKETS=6
# CONFIG_LWIP_DHCP_DOES_ARP_CHECK is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=12
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_GMAC_SUPPORT is not set
# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE is not set
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
