# Overlay for the FLIGHT image (the default; kept so both images are built the
# same way: SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.flight").
CONFIG_WITNESS_IMAGE_FLIGHT=y
# CONFIG_WITNESS_IMAGE_MAINTENANCE is not set

# Landed low-power mode (landed_logic.h, sensors_landed.cpp): automatic light
# sleep is enabled at run time only while Landed (esp_pm_configure); until then
# power management does nothing (no frequency scaling, no sleep). Tickless idle
# is what lets the idle task sleep the MCU between events.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# IDF isolates every GPIO pad in light sleep (CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND,
# on by default for this chip); sensors_landed.cpp keeps the pads it needs with
# gpio_sleep_sel_dis(). PM_SLP_DISABLE_GPIO is the same mechanism through PM; keep it off.
# CONFIG_PM_SLP_DISABLE_GPIO is not set

# Keep the MCU out of automatic light sleep while a USB host is attached (the
# driver's SOF monitor holds a NO_LIGHT_SLEEP lock). Without it a sleep with USB
# attached killed the USB link for good (bench 2026-11-15).
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
